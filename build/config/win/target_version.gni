import("//build/toolchain/toolchain.gni")
import("//build/toolchain/win_ver.gni")

## Flags used to control compiler/linker flags and defines
## to support older versions of Windows.

declare_args() {
  # What windows version to target. Valid string values are
  win_ver = ""

  # Never set these manually! They are used internally in .gni files only!
  is_win2k_build = false
  is_winxp_build = false
  is_win2003_build = false
  is_winvista_build = false
  is_win7_build = false
  is_win8_build = false
  is_win81_build = false
  is_win10_build = false
  is_win11_build = false
  subsystem_version_suffix = ""
}

if (win_ver == "2k" || win_ver == "2K" || win_ver == "2000" || win_ver == "5.0") {
  is_win2k_build = true
} else if (win_ver == "xp" || win_ver == "XP" || win_ver == "5.1") {
  is_winxp_build = true
} else if (win_ver == "2K3" || win_ver == "2003" || win_ver == "2003R2" || win_ver == "5.2") {
  is_win2003_build = true
} else if (win_ver == "vista" || win_ver == "Vista" || win_ver == "2008" || win_ver == "6.0") {
  is_winvista_build = true
} else if (win_ver == "7" || win_ver == "2008R2" || win_ver == "2011" || win_ver == "6.1") {
  is_win7_build = true
} else if (win_ver == "8" || win_ver == "8.0" || win_ver == "2012" || win_ver == "6.2") {
  is_win8_build = true
} else if (win_ver == "8.1" || win_ver == "2012R2" || win_ver == "6.3") {
  is_win81_build = true
} else if (win_ver == "10" || win_ver == "2016" || win_ver == "2019" || win_ver == "2022" || win_ver == "10.0") {
  is_win10_build = true
} else if (win_ver == "11" || win_ver == "2025" || win_ver == "10.1") {
  is_win11_build = true
} else if (win_ver == "") {
  print("WARNING: win_ver was not set!")
  print("Setting win_ver constants to default Win7 target values.")
  is_win7_build = true
}

declare_args() {
  # win32 SDK defines
  winver_version = ""
  win32_winnt_version = ""
  win64_winnt_version = ""
  win32_ie_version = ""
  ntddi_version = ""
  psapi_version = 0

  # Whether to use and link in the libnt5 library for supporting Windows 2000
  use_libnt5 = is_win2k_build
}

declare_args() {
  # Whether to use the Windows XP/2003 compatible toolchain
  use_legacy_toolchain = is_win2k_build || is_winxp_build || is_win2003_build || use_libnt5

  # Whether to use common controls version 6.0 via Manifest
  # Note that due to contraints, comctl32 is always linked in.
  use_common_controls = !is_win2k_build && !is_winxp_build && !is_win2003_build
}

if (is_win2k_build) {
  winver_version = WINNT_WIN2K
  win32_winnt_version = WINNT_WIN2K
  win64_winnt_version = WINNT_WS03
  win32_ie_version = IE_WIN2K
  ntddi_version = NTDDI_WIN2K
  psapi_version = 1
} else if (is_winxp_build) {
  winver_version = WINNT_WINXP
  win32_winnt_version = WINNT_WINXP
  win64_winnt_version = WINNT_WS03
  win32_ie_version = IE_XPSP1
  ntddi_version = NTDDI_WINXPSP1
  psapi_version = 1
} else if (is_win2003_build) {
  winver_version = WINNT_WS03
  win32_winnt_version = WINNT_WS03
  win64_winnt_version = WINNT_WS03
  win32_ie_version = IE_WS03SP1
  ntddi_version = NTDDI_WS03SP1
  psapi_version = 1
} else if (is_winvista_build) {
  winver_version = WINNT_VISTA
  win32_winnt_version = WINNT_VISTA
  win64_winnt_version = WINNT_LONGHORN
  win32_ie_version = IE_VISTA
  ntddi_version = NTDDI_LONGHORN
  psapi_version = 1
} else if (is_win7_build) {
  winver_version = WINNT_WIN7
  win32_winnt_version = WINNT_WIN7
  win64_winnt_version = WINNT_WIN7
  win32_ie_version = IE_WIN7
  ntddi_version = NTDDI_WIN7
  psapi_version = 2
} else if (is_win8_build) {
  winver_version = WINNT_WIN8
  win32_winnt_version = WINNT_WIN8
  win64_winnt_version = WINNT_WIN8
  win32_ie_version = IE_WIN8
  ntddi_version = NTDDI_WIN8
  psapi_version = 2
} else if (is_win81_build) {
  winver_version = WINNT_WINBLUE
  win32_winnt_version = WINNT_WINBLUE
  win64_winnt_version = WINNT_WINBLUE
  win32_ie_version = IE_WINBLUE
  ntddi_version = NTDDI_WINBLUE
  psapi_version = 2
} else if (is_win10_build) {
  winver_version = WINNT_WIN10
  win32_winnt_version = WINNT_WIN10
  win64_winnt_version = WINNT_WIN10
  win32_ie_version = IE_WIN10
  ntddi_version = NTDDI_WINTHRESHOLD
  psapi_version = 2
} else if (is_win11_build) {
  winver_version = WINNT_WIN11
  win32_winnt_version = WINNT_WIN11
  win64_winnt_version = WINNT_WIN11
  win32_ie_version = IE_WIN11
  ntddi_version = NTDDI_WIN11_CO
  psapi_version = 2
} else {
}

assert(is_win2k_build || is_winxp_build ||
       is_win2003_build || is_winvista_build ||
       is_win7_build || is_win8_build ||
       is_win81_build || is_win10_build ||
       is_win11_build, "winver not set!")

if (print_toolchain_info) {
  print("is_win2k_build =", is_win2k_build)
  print("is_winxp_build =", is_winxp_build)
  print("is_win2003_build =", is_win2003_build)
  print("is_winvista_build =", is_winvista_build)
  print("is_win7_build =", is_win7_build)
  print("is_win8_build =", is_win8_build)
  print("is_win81_build =", is_win81_build)
  print("is_win10_build =", is_win10_build)
  print("is_win11_build =", is_win11_build)
}

if (use_libnt5) {
  assert(is_win2k_build || is_winxp_build || is_win2003_build, "use_libnt5 = true can only be used with pre-Vista Windows targets")
}

assert(psapi_version != 0, "psapi_version was still 0!")

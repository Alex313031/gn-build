WINNT_WIN2K        = "0x0500" # Windows 2000
WINNT_WINXP        = "0x0501" # Windows XP
WINNT_WS03         = "0x0502" # Windows Server 2003
WINNT_WIN6         = "0x0600" # Windows Vista
WINNT_LONGHORN     = "0x0600" # Windows Longhorn
WINNT_VISTA        = "0x0600" # Windows Vista
WINNT_WS08         = "0x0600" # Windows Server 2008
WINNT_WIN7         = "0x0601" # Windows 7
WINNT_WIN8         = "0x0602" # Windows 8
WINNT_WINBLUE      = "0x0603" # Windows 8.1
WINNT_WINTHRESHOLD = "0x0A00" # Windows 10
WINNT_WIN10        = "0x0A00" # Windows 10
WINNT_WIN11        = WINNT_WIN10 # Windows 11

# _WIN32_IE_ version constants used for _WIN32_IE and the section below

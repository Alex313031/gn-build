IE_IE40    = "0x0400" # I.E. 4.00
IE_IE401   = "0x0401" # I.E. 4.01 / 4.02
IE_IE50    = "0x0500" # I.E. 5.00
IE_IE501   = "0x0501" # I.E. 5.01 (Legacy common controls minimum target)
IE_IE55    = "0x0550" # I.E. 5.50 / 5.51 (For Windows ME/2000)
IE_IE60    = "0x0600" # I.E. 6.00 (Minimum recognized by MSVC)
IE_IE60SP1 = "0x0601" # I.E. 6.01 (SP1) (Modern common controls minimum target)
IE_IE602   = "0x0602" # I.E. 6.02 (SP1) (Only released bundled with Server 2003)
